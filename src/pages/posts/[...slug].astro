---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, appLink } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const site = Astro.site!.toString().replace(/\/$/, '');
const url = `${site}/posts/${post.id}/`;
const pageTitle = d.metaTitle ?? `${d.title} | 캐스트하우스`;
const fmt = (date: Date) =>
  new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long', timeZone: 'Asia/Seoul' }).format(date);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    keywords: d.keywords.join(', '),
    inLanguage: 'ko-KR',
    datePublished: d.publishedAt.toISOString(),
    dateModified: (d.updatedAt ?? d.publishedAt).toISOString(),
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: '캐스트하우스', url: 'https://casthouse.co' },
    publisher: { '@type': 'Organization', name: '캐스트하우스', url: 'https://casthouse.co' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '캐스트하우스 블로그', item: site },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
];
---

<Base
  title={pageTitle}
  description={d.description}
  path={`/posts/${post.id}/`}
  type="article"
  ogImage={d.ogImage}
  publishedAt={d.publishedAt}
  updatedAt={d.updatedAt}
  jsonLd={jsonLd}
  ctaSlug={post.id}
>
  <article class="article">
    <span class="meta">{d.category}</span>
    <h1>{d.title}</h1>
    <p class="meta">
      <time datetime={d.publishedAt.toISOString()}>{fmt(d.publishedAt)}</time>
    </p>

    <Content />

    <section class="cta-card">
      <h2>평생 가족, 함께 살아보고 결정할 수 있어요.</h2>
      <p>사진 한 장, 영상 한 편 말고, 일상의 삶을 통해 고양이와 내가 가족이 될 수 있는지 미리 확인해보는건 어떨까요?</p>
      <a class="pill" href={appLink(post.id)}>입양을 기다리는 아이들 보기</a>
    </section>
  </article>
</Base>

<script>
  // 카드뉴스 캐러셀: 스와이프는 CSS scroll-snap, 여기서는 카운터·점·화살표만 담당
  document.querySelectorAll<HTMLElement>('.carousel').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.carousel-track');
    if (!track) return;
    const slides = Array.from(track.children) as HTMLElement[];
    const count = root.querySelector<HTMLElement>('.carousel-count');
    const dots = root.querySelector<HTMLElement>('.carousel-dots');
    const prev = root.querySelector<HTMLButtonElement>('.carousel-prev');
    const next = root.querySelector<HTMLButtonElement>('.carousel-next');
    let idx = 0;
    const go = (i: number) => track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    slides.forEach((_, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', `${i + 1}번째 카드`);
      b.addEventListener('click', () => go(i));
      dots?.appendChild(b);
    });
    const update = () => {
      idx = Math.round(track.scrollLeft / track.clientWidth);
      idx = Math.max(0, Math.min(slides.length - 1, idx));
      if (count) count.textContent = `${idx + 1} / ${slides.length}`;
      dots?.querySelectorAll('button').forEach((b, i) => b.classList.toggle('on', i === idx));
      if (prev) prev.disabled = idx === 0;
      if (next) next.disabled = idx === slides.length - 1;
    };
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    prev?.addEventListener('click', () => go(Math.max(0, idx - 1)));
    next?.addEventListener('click', () => go(Math.min(slides.length - 1, idx + 1)));
    update();
  });

  // 전체화면 보기: 카드를 탭하면 어두운 배경 위에 크게 띄움
  const carousels = document.querySelectorAll<HTMLElement>('.carousel');
  if (carousels.length) {
    const lb = document.createElement('div');
    lb.className = 'lightbox';
    lb.hidden = true;
    lb.setAttribute('role', 'dialog');
    lb.setAttribute('aria-modal', 'true');
    lb.setAttribute('aria-label', '카드뉴스 전체화면');
    lb.innerHTML = '<button type="button" class="lb-close" aria-label="닫기">✕</button><div class="lb-track"></div><button type="button" class="lb-prev" aria-label="이전 카드">‹</button><button type="button" class="lb-next" aria-label="다음 카드">›</button><div class="lb-count"></div>';
    document.body.appendChild(lb);
    const lbTrack = lb.querySelector<HTMLElement>('.lb-track')!;
    const lbCount = lb.querySelector<HTMLElement>('.lb-count')!;
    const lbPrev = lb.querySelector<HTMLButtonElement>('.lb-prev')!;
    const lbNext = lb.querySelector<HTMLButtonElement>('.lb-next')!;
    let lbIdx = 0;
    let lastFocus: HTMLElement | null = null;
    const lbGo = (i: number, smooth = true) => lbTrack.scrollTo({ left: i * lbTrack.clientWidth, behavior: smooth ? 'smooth' : 'instant' });
    const lbUpdate = () => {
      const n = lbTrack.children.length;
      lbIdx = Math.max(0, Math.min(n - 1, Math.round(lbTrack.scrollLeft / lbTrack.clientWidth)));
      lbCount.textContent = `${lbIdx + 1} / ${n}`;
      lbPrev.disabled = lbIdx === 0;
      lbNext.disabled = lbIdx === n - 1;
    };
    const close = () => {
      lb.hidden = true;
      document.body.style.overflow = '';
      lastFocus?.focus();
    };
    const open = (imgs: HTMLImageElement[], start: number) => {
      lbTrack.innerHTML = '';
      imgs.forEach((src) => {
        const d = document.createElement('div');
        d.className = 'lb-slide';
        const im = document.createElement('img');
        im.src = src.currentSrc || src.src;
        im.alt = src.alt;
        d.appendChild(im);
        lbTrack.appendChild(d);
      });
      lastFocus = document.activeElement as HTMLElement | null;
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
      lbGo(start, false);
      lbUpdate();
      lb.querySelector<HTMLButtonElement>('.lb-close')!.focus();
    };
    lbTrack.addEventListener('scroll', () => requestAnimationFrame(lbUpdate), { passive: true });
    lbTrack.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName !== 'IMG') close(); });
    lb.querySelector('.lb-close')!.addEventListener('click', close);
    lbPrev.addEventListener('click', () => lbGo(Math.max(0, lbIdx - 1)));
    lbNext.addEventListener('click', () => lbGo(Math.min(lbTrack.children.length - 1, lbIdx + 1)));
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') lbGo(Math.max(0, lbIdx - 1));
      if (e.key === 'ArrowRight') lbGo(Math.min(lbTrack.children.length - 1, lbIdx + 1));
    });
    carousels.forEach((root) => {
      const imgs = Array.from(root.querySelectorAll<HTMLImageElement>('.slide img'));
      imgs.forEach((img, i) => img.addEventListener('click', () => open(imgs, i)));
    });
  }
</script>
