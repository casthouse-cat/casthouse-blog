---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import CategoryChips from '../components/CategoryChips.astro';
import CardNewsStrip from '../components/CardNewsStrip.astro';
import { getPublishedPosts } from '../lib/posts';

const all = await getPublishedPosts();
const cardNews = all.filter((p) => p.data.cardCount && p.data.thumbnail);
const posts = all.filter((p) => !(p.data.cardCount && p.data.thumbnail));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: '캐스트하우스',
    url: 'https://casthouse.co',
    description: '입양을 기다리는 보호소 소속 고양이와 함께 살아본 뒤 입양을 결정하는 유기묘 입양 플랫폼',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: '캐스트하우스 블로그',
    url: Astro.site!.toString(),
    inLanguage: 'ko-KR',
  },
];
---

<Base
  title="캐스트하우스 블로그 | 유기묘 입양 전 함께 살아보기"
  description="고양이와 실제로 함께 살아보면 보이는 것들. 입양 전 경험, 고양이 성격 맞춤, 털날림·알레르기 같은 현실적인 고민을 정리했어요."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <h1 class="sr-only">캐스트하우스 블로그</h1>
    <p>입양을 결정하기 전에, 함께 살아보며 알게 되는 것들과 입양을 하기 전에 고려해야 하는 사항들, 캐스트하우스 이용 방법 등을 기록합니다.</p>
  </section>

  <CategoryChips />
  <CardNewsStrip posts={cardNews} />
  <PostList posts={posts} />
</Base>
