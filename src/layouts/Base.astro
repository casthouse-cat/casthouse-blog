---
import '../styles/global.css';
import { appLink } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  path: string; // 예: '/posts/my-slug/'
  ogImage?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  jsonLd?: Record<string, unknown>[];
  ctaSlug?: string;
}

const {
  title,
  description,
  path,
  ogImage,
  type = 'website',
  publishedAt,
  updatedAt,
  jsonLd = [],
  ctaSlug = 'home',
} = Astro.props;

const site = Astro.site!.toString().replace(/\/$/, '');
// GitHub Pages는 폴더형 주소(끝에 슬래시)로 내보내므로 canonical도 슬래시로 통일한다.
const canonical = `${site}${path.endsWith('/') ? path : `${path}/`}`;
const image = ogImage
  ? ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`
  : `${site}/logo.png`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="naver-site-verification" content="014bb6d9dd4912b73f33ea2c5ab6754bb781715f" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content="캐스트하우스" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="캐스트하우스 블로그 홈">
        <img src="/logo.png" alt="캐스트하우스 로고" width="32" height="32" />
        <span>CASTHOUSE BLOG</span>
      </a>
      <a class="pill pill-sm" href={appLink(ctaSlug)}>앱으로 가기</a>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      <p>캐스트하우스는 입양을 기다리는 보호소 소속 고양이와 함께 살아본 뒤 입양을 결정하는 유기묘 입양 플랫폼이에요.</p>
      <p><a href={appLink(ctaSlug)}>casthouse.co</a></p>
    </footer>
  </body>
</html>
