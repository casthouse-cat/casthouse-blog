---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

{posts.length === 0 ? (
  <p>곧 첫 글이 올라와요.</p>
) : (
  <div class="list-head"><b>최신 글</b><span>{posts.length}</span></div>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class={`post-item${post.data.thumbnail ? ' has-thumb' : ''}`} href={`/posts/${post.id}/`}>
          <div class="post-text">
            <span class="post-meta">
              <b>{post.data.category}</b> · {fmt(post.data.publishedAt)}
              {post.data.cardCount && <span class="badge">카드뉴스 {post.data.cardCount}장</span>}
            </span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </div>
          {post.data.thumbnail && (
            <img class="post-thumb" src={post.data.thumbnail} alt="" width="96" height="120" loading="lazy" />
          )}
        </a>
      </li>
    ))}
  </ul>
)}
